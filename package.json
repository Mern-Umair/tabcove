{
  "name": "tabcove",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Chrome extension that saves, restores and backs up tabs and windows.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\" \"scripts/*.mjs\" \"public/manifest.json\"",
    "zip": "node scripts/zip.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "prettier": {
    "printWidth": 120
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "preact": "^11.0.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
