{
  "manifest_version": 3,
  "name": "Tabcove: Save, Restore & Back Up Tabs",
  "short_name": "Tabcove",
  "version": "1.0.0",
  "description": "Never lose your tabs again. Auto-saves every window, restores sessions in one click, backs up tabs on your computer. No account.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabcove: save and restore tabs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "manager.html#settings",
    "open_in_tab": true
  },
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "alarms", "favicon"],
  "host_permissions": ["https://api.gumroad.com/*"],
  "commands": {
    "save-session": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save all windows as a session"
    },
    "open-manager": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Open the Tabcove manager"
    }
  }
}
